---
import Base from "../layouts/Base.astro";
---
<Base path="/" title="Aidvue — Get seen, get booked, get paid.">
  <div class="wrap" style="padding:48px 0">
    <h1>Aidvue helps local businesses get seen, get booked, get paid.</h1>
    <p style="color:#A6B6D9;max-width:760px">Turn missed calls & empty slots into paid jobs. The 5‑in‑30 Guarantee removes the risk.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <a href="/book" class="cta">Book a Free Demo</a>
      <a href="/pricing" class="cta">See Pricing</a>
    </div>
    <img src="/assets/hero-poster.svg" alt="" width="100%" style="margin-top:12px;border-radius:12px;border:1px solid var(--line);opacity:.95"/>
  </div>
</Base>
