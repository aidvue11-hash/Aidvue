---
import Base from "../layouts/Base.astro";
---
<Base path="/roi" title="Aidvue ROI Calculator">
  <main class="wrap" style="padding:36px 0">
    <h1>ROI Calculator</h1>
    <p style="color:#A6B6D9">Estimate monthly revenue lost and what Aidvue could recover.</p>
    <div class="section" style="padding:18px;border-radius:14px;max-width:820px">
      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px">
        <label>Average Job Value ($): <input id="job" type="number" value="250" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--line)"></label>
        <label>Missed Calls per Week: <input id="missed" type="number" value="5" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--line)"></label>
        <label>Close Rate (%): <input id="close" type="number" value="60" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--line)"></label>
      </div>
      <div style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap">
        <button class="cta" onclick="calc()">Calculate ROI</button>
        <a href="/book" class="cta secondary">Book a Demo</a>
      </div>
      <div id="out" style="margin-top:10px"></div>
    </div>
    <script>
      function usd(n){return n.toLocaleString(undefined,{style:'currency',currency:'USD'});}
      function calc(){
        var job=parseFloat(document.getElementById('job').value||0);
        var missed=parseFloat(document.getElementById('missed').value||0);
        var close=parseFloat(document.getElementById('close').value||0)/100;
        var missedMonthly=missed*4.3, bookedLost=missedMonthly*close;
        var revenueLost=bookedLost*job, recovered=revenueLost*0.6;
        var plan=recovered>1000?"Aidvue OS ($997/mo)":(recovered>300?"Aidvue Calls ($297/mo)":"Aidvue Reviews ($97/mo)");
        document.getElementById('out').innerHTML="<div class='banner'><b>Revenue Lost:</b> "+usd(revenueLost)+" &nbsp;•&nbsp; <b>Aidvue Could Recover:</b> "+usd(recovered)+"<br/><span style='color:#A6B6D9'>Recommended plan: "+plan+"</span></div>";
        if(window.aidvueTrack) aidvueTrack('roi_calculated',{recovered:recovered});
      }
    </script>
  </main>
</Base>
